# Copy to backend/.env to override the defaults. All variables are optional.

# Port of the API (the Vite dev server proxies /api to it).
PORT=3031

# SQLite database file, relative to backend/. Created on first start.
DATABASE_FILE=data/koomb.db

# Artificial wait before each page fetch, in ms, to see "in progress" in the UI.
# `npm run dev` uses 3000 unless set; `npm start` and tests use 0.
SCRAPE_DELAY_MS=3000
